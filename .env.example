# Copy to .env and edit. Never commit .env.
LOG_LEVEL=info

# --- API ---
# Secure cookies: keep true in production (HTTPS via Nginx). Set false only for plain-HTTP local testing.
COOKIE_SECURE=true
# One-time first-admin setup from the dashboard. Remove this line after creating the admin, or create the
# admin from the shell instead: docker compose exec api npm run create-admin -- admin
SETUP_TOKEN=
# Extra browser origins allowed to call the API (comma separated). Empty = same origin only.
ALLOWED_ORIGINS=
SESSION_TTL_HOURS=12
BACKUP_RETENTION=14

# --- Worker ---
WORKER_HEALTH_PORT=8081
